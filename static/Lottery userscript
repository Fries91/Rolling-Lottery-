    function ensureMounted() {
        if (!document.body) return;

        if (!els.shield || !document.body.contains(els.shield)) {
            let shield = byId('sl-shield');
            if (!shield) {
                shield = document.createElement('button');
                shield.id = 'sl-shield';
                shield.innerHTML = `
                    <span class="sl-shield-top">Sinner's</span>
                    <span class="sl-shield-main">Lottery</span>
                `;
                document.body.appendChild(shield);
                bindTap(shield, () => toggleOverlay());
                makeHoldDraggable(shield, shield, K_SHIELD_POS);
            }
            els.shield = shield;
            applySavedPosition(els.shield, K_SHIELD_POS, { right: '12px', top: '45%' });
        }

        if (!els.overlay || !document.body.contains(els.overlay)) {
            let overlay = byId('sl-overlay');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.id = 'sl-overlay';
                document.body.appendChild(overlay);
            }
            els.overlay = overlay;
            applySavedPosition(els.overlay, K_OVERLAY_POS, { right: '12px', top: '90px' });
        }

        const isOpen = !!getStored(K_OPEN, false);
        els.overlay.style.display = isOpen ? 'block' : 'none';
    }

    function toggleOverlay(force) {
        ensureMounted();
        const open = typeof force === 'boolean' ? force : els.overlay.style.display !== 'block';
        els.overlay.style.display = open ? 'block' : 'none';
        setStored(K_OPEN, open ? 1 : 0);
        if (open) {
            render();
