        }
    }

    function applySavedPosition(el, key, fallback) {
        const saved = getStored(key, null);
        if (saved && typeof saved === 'object') {
            if (saved.left != null) el.style.left = saved.left;
            if (saved.top != null) el.style.top = saved.top;
            if (saved.right != null) el.style.right = saved.right;
            if (saved.bottom != null) el.style.bottom = saved.bottom;
        } else {
            Object.keys(fallback).forEach(k => {
                el.style[k] = fallback[k];
            });
        }
    }

    function makeHoldDraggable(handle, target, storageKey) {
        if (!handle || !target) return;

        let dragging = false;
        let startX = 0;
        let startY = 0;
        let startLeft = 0;
        let startTop = 0;
        let holdTimer = null;

        const begin = (clientX, clientY) => {
            const rect = target.getBoundingClientRect();
            dragging = true;
            startX = clientX;
            startY = clientY;
            startLeft = rect.left;
            startTop = rect.top;
            target.classList.add('dragging');
        };

        const move = (clientX, clientY) => {
            if (!dragging) return;
            const dx = clientX - startX;
            const dy = clientY - startY;
            target.style.left = `${Math.max(0, startLeft + dx)}px`;
            target.style.top = `${Math.max(0, startTop + dy)}px`;
            target.style.right = 'auto';
            target.style.bottom = 'auto';
        };

        const end = () => {
            if (!dragging) return;
            dragging = false;
            target.classList.remove('dragging');
            setStored(storageKey, {
                left: target.style.left || '',
                top: target.style.top || '',
                right: target.style.right || '',
                bottom: target.style.bottom || '',
            });
        };

        handle.addEventListener('touchstart', (e) => {
            const t = e.touches[0];
            holdTimer = setTimeout(() => begin(t.clientX, t.clientY), 250);
        }, { passive: true });

        handle.addEventListener('touchmove', (e) => {
            const t = e.touches[0];
            if (dragging) {
                e.preventDefault();
                move(t.clientX, t.clientY);
            }
        }, { passive: false });

        handle.addEventListener('touchend', () => {
            clearTimeout(holdTimer);
            end();
        });

        handle.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            holdTimer = setTimeout(() => begin(e.clientX, e.clientY), 200);
        });

        document.addEventListener('mousemove', (e) => {
            if (dragging) move(e.clientX, e.clientY);
        });

        document.addEventListener('mouseup', () => {
            clearTimeout(holdTimer);
            end();
        });

        handle.addEventListener('mouseleave', () => {
            clearTimeout(holdTimer);
        });
    }

