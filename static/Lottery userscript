// ==UserScript==
// @name         Sinner's Lottery
// @namespace    sinners-lottery
// @version      1.0.0
// @description  Faction-only weekly lottery with spinning wheel, buy tickets, verify payment, history, and admin tools.
// @author       Fries91
// @match        https://www.torn.com/*
// @match        https://torn.com/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @grant        GM_addStyle
// @grant        GM_xmlhttpRequest
// @connect      *
// @run-at       document-end
// ==/UserScript==

(function () {
    'use strict';

    // ============================================================
    // 01. CONFIG
    // ============================================================

    const APP_NAME = "Sinner's Lottery";
    const BASE_URL = 'https://YOUR-RENDER-APP.onrender.com'; // <-- replace this
    const ADMIN_USER_ID = 3679030;
    const ADMIN_NAME = 'Fries91';

    const K_OPEN = 'sinners_lottery_open';
    const K_TAB = 'sinners_lottery_tab';
    const K_SHIELD_POS = 'sinners_lottery_shield_pos';
    const K_OVERLAY_POS = 'sinners_lottery_overlay_pos';
    const K_SESSION = 'sinners_lottery_session';
    const K_WHEEL_ROT = 'sinners_lottery_wheel_rot';

    const DEFAULT_TAB = 'lottery';
    const POLL_MS = 30000;
    const REMOUNT_MS = 2000;

    let state = {
        me: null,
        settings: null,
        round: null,
        history: [],
        wheelEntries: [],
        lastWinner: null,
        adminState: null,
        buyQty: 1,
        spinning: false,
        spinTargetIndex: -1,
        spinRotation: Number(GM_getValue(K_WHEEL_ROT, 0)) || 0,
    };

    let els = {
        shield: null,
        overlay: null,
        body: null,
    };

    let pollTimer = null;
    let remountTimer = null;

    // ============================================================
    // 02. STORAGE
    // ============================================================

    function getStored(key, fallback) {
        try {
            const v = GM_getValue(key);
            return v == null ? fallback : v;
        } catch {
            return fallback;
        }
    }

    function setStored(key, value) {
        try {
            GM_setValue(key, value);
        } catch (_) {}
    }

    function getSession() {
        return getStored(K_SESSION, null);
    }

    function setSession(data) {
        setStored(K_SESSION, data);
    }

    function clearSession() {
        try {
            GM_deleteValue(K_SESSION);
        } catch (_) {
            setStored(K_SESSION, null);
        }
    }

    // ============================================================
    // 03. HELPERS
    // ============================================================

    function fmtMoney(n) {
        const num = Number(n || 0);
        return '$' + num.toLocaleString();
    }

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function nowMs() {
        return Date.now();
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function byId(id) {
        return document.getElementById(id);
    }

    function isAdmin() {
        return !!(state.me && state.me.is_admin);
    }

    function currentTab() {
        return getStored(K_TAB, DEFAULT_TAB);
    }

    function setCurrentTab(tab) {
        setStored(K_TAB, tab);
    }

    function safeJsonParse(text, fallback = null) {
        try {
            return JSON.parse(text);
        } catch {
            return fallback;
        }
    }

    function formatDateTime(iso) {
        if (!iso) return '-';
        const d = new Date(iso);
        if (isNaN(d.getTime())) return iso;
        return d.toLocaleString();
    }

    function countdownTo(iso) {
        if (!iso) return 'No draw set';
        const target = new Date(iso).getTime();
        if (!target) return 'No draw set';
        const diff = target - nowMs();
        if (diff <= 0) return 'Drawing now / closed';
        const s = Math.floor(diff / 1000);
        const days = Math.floor(s / 86400);
        const hrs = Math.floor((s % 86400) / 3600);
        const mins = Math.floor((s % 3600) / 60);
        const secs = s % 60;
        if (days > 0) return `${days}d ${hrs}h ${mins}m ${secs}s`;
        return `${hrs}h ${mins}m ${secs}s`;
    }

    function pickColor(i, total) {
        const palette = [
            '#5b0d12', '#7a1118', '#98141d', '#b61722',
            '#861018', '#621016', '#8e2020', '#4f0d10'
        ];
        return palette[i % palette.length];
    }

    function bindTap(el, fn) {
        if (!el) return;
        let touched = false;
        el.addEventListener('touchend', (e) => {
            touched = true;
            e.preventDefault();
            fn(e);
            setTimeout(() => { touched = false; }, 350);
        }, { passive: false });
        el.addEventListener('click', (e) => {
            if (touched) return;
            e.preventDefault();
            fn(e);
        });
    }

    function showToast(msg, bad = false) {
        let box = byId('sl-toast');
        if (!box) {
            box = document.createElement('div');
            box.id = 'sl-toast';
            document.body.appendChild(box);
        }
        box.className = 'show' + (bad ? ' bad' : '');
        box.textContent = msg;
        clearTimeout(box._hideTimer);
        box._hideTimer = setTimeout(() => {
            box.className = '';
        }, 2800);
    }

    // ============================================================
    // 04. API
    // ============================================================

    function getAuthHeaders() {
        const sess = getSession();
        if (!sess || !sess.user_id) return {};
        return {
            'X-User-Id': String(sess.user_id),
            'X-User-Name': String(sess.user_name || ''),
            'X-Faction-Id': String(sess.faction_id || 0),
            'X-Is-Admin': String(sess.is_admin ? 1 : 0),
        };
    }

    function api(path, method = 'GET', body = null) {
        return new Promise((resolve, reject) => {
            const headers = Object.assign(
                {
                    'Content-Type': 'application/json',
                },
                getAuthHeaders()
            );

            GM_xmlhttpRequest({
                method,
                url: BASE_URL + path,
                headers,
                data: body ? JSON.stringify(body) : null,
                onload: (res) => {
                    const json = safeJsonParse(res.responseText, null);
                    if (res.status >= 200 && res.status < 300 && json) {
                        resolve(json);
                    } else {
                        reject(json || { ok: false, error: `HTTP ${res.status}` });
                    }
                },
                onerror: () => reject({ ok: false, error: 'Network error' }),
                ontimeout: () => reject({ ok: false, error: 'Request timed out' }),
                timeout: 30000,
            });
        });
    }

    // ============================================================
    // 05. LOGIN
    // ============================================================

    async function loginFlow() {
        const old = getSession() || {};
        const userId = prompt('Enter your Torn user ID:', old.user_id || '');
        if (!userId) return;

        const userName = prompt('Enter your Torn name:', old.user_name || '');
        if (!userName) return;

        const factionId = prompt('Enter your faction ID:', old.faction_id || '');
        if (factionId == null || factionId === '') return;

        try {
            const res = await api('/api/login', 'POST', {
                user_id: Number(userId),
                user_name: userName,
                faction_id: Number(factionId),
            });
            if (!res.ok) throw new Error(res.error || 'Login failed');

            const sessionData = res.user || {
                user_id: Number(userId),
                user_name: userName,
                faction_id: Number(factionId),
                is_admin: Number(userId) === ADMIN_USER_ID,
            };
            setSession(sessionData);
            state.me = sessionData;
            showToast('Logged in');
            await loadAll();
        } catch (e) {
            showToast(e.error || e.message || 'Login failed', true);
        }
    }

    async function logoutFlow() {
        try {
            await api('/api/logout', 'POST', {});
        } catch (_) {}
        clearSession();
        state.me = null;
        state.settings = null;
        state.round = null;
        state.history = [];
        state.wheelEntries = [];
        state.lastWinner = null;
        state.adminState = null;
        render();
        showToast('Logged out');
    }

    // ============================================================
    // 06. DATA LOAD
    // ============================================================

    async function loadState() {
        const res = await api('/api/lottery/state');
        state.settings = res.settings || null;
        state.round = res.round || null;
        state.me = res.me || getSession() || null;
        state.lastWinner = res.last_winner || null;
    }

    async function loadWheel() {
        const res = await api('/api/lottery/wheel');
        state.wheelEntries = Array.isArray(res.entries) ? res.entries : [];
    }

    async function loadHistory() {
        const res = await api('/api/lottery/history');
        state.history = Array.isArray(res.history) ? res.history : [];
    }

    async function loadAdminState() {
        if (!isAdmin()) return;
        const res = await api('/api/lottery/admin/state');
        state.adminState = res || null;
    }

    async function loadAll() {
        try {
            await loadState();
            await Promise.allSettled([
                loadWheel(),
                loadHistory(),
                isAdmin() ? loadAdminState() : Promise.resolve(),
            ]);
            render();
        } catch (e) {
            render();
            showToast(e.error || e.message || 'Could not load lottery data', true);
        }
    }

    // ============================================================
    // 07. BUY / VERIFY / ADMIN
    // ============================================================

    async function buyTicketsFlow() {
        if (!state.round || !state.settings || !state.me) return;
        const qty = Math.max(1, Math.min(Number(state.buyQty || 1), Number(state.settings.max_tickets_per_member || 5)));

        try {
            const buy = await api('/api/lottery/buy', 'POST', { quantity: qty });
            if (!buy.ok) throw new Error(buy.error || 'Buy failed');

            const message =
                `Send ${fmtMoney(buy.amount_due)} to ${buy.payment_to.name} [${buy.payment_to.user_id}] in Torn, then press OK to verify.\n\n` +
                `Quantity: ${qty}\n` +
                `Ticket price: ${fmtMoney(buy.ticket_price)}\n` +
                `Amount due: ${fmtMoney(buy.amount_due)}`;

            const go = confirm(message);
            if (!go) return;

            let paymentRef = prompt('Optional payment reference / note for your own tracking:', '') || '';

            const verified = await api('/api/lottery/verify-payment', 'POST', {
                quantity: qty,
                payment_ref: paymentRef,
            });
            if (!verified.ok) throw new Error(verified.error || 'Verify failed');

            showToast(`Added ${verified.added_tickets} ticket(s)`);
            await loadAll();
        } catch (e) {
            showToast(e.error || e.message || 'Buy/verify failed', true);
        }
    }

    async function forceDrawFlow() {
        if (!isAdmin()) return;
        try {
            const res = await api('/api/lottery/admin/force-draw', 'POST', {});
            if (!res.ok) throw new Error(res.error || 'Force draw failed');
            showToast('Draw completed');
            await loadAll();
            await startWinnerSpinFromBackend();
        } catch (e) {
            showToast(e.error || e.message || 'Force draw failed', true);
        }
    }

    async function cancelRoundFlow() {
        if (!isAdmin()) return;
        const reason = prompt('Cancel round reason:', '') || '';
        try {
            const res = await api('/api/lottery/admin/cancel-round', 'POST', { reason });
            if (!res.ok) throw new Error(res.error || 'Cancel failed');
            showToast('Round cancelled');
            await loadAll();
        } catch (e) {
            showToast(e.error || e.message || 'Cancel failed', true);
        }
    }

    async function saveAdminSettings() {
        if (!isAdmin()) return;

        const ticketPrice = Number(byId('sl-admin-ticket-price')?.value || 1000000);
        const prizePercent = Number(byId('sl-admin-prize-percent')?.value || 75);
        const maxTickets = Number(byId('sl-admin-max-tickets')?.value || 5);
        const factionId = Number(byId('sl-admin-faction-id')?.value || 0);
        const enabled = byId('sl-admin-enabled')?.checked ? 1 : 0;

        try {
            const res = await api('/api/lottery/admin/settings', 'POST', {
                enabled,
                faction_id: factionId,
                payment_receiver_id: ADMIN_USER_ID,
                payment_receiver_name: ADMIN_NAME,
                ticket_price: ticketPrice,
                prize_percent: prizePercent,
                max_tickets_per_member: maxTickets,
                draw_day: 6,
                draw_hour: 20,
                draw_minute: 0,
                timezone: 'America/Toronto',
            });
            if (!res.ok) throw new Error(res.error || 'Save failed');
            showToast('Settings updated');
            await loadAll();
        } catch (e) {
            showToast(e.error || e.message || 'Save failed', true);
        }
    }

    // ============================================================
    // 08. WHEEL
    // ============================================================

    function getWinnerTicketNumber() {
        if (!state.round || state.round.status !== 'drawn') return null;
        return Number(state.round.winning_ticket_number || 0) || null;
    }

    async function startWinnerSpinFromBackend() {
        if (state.spinning) return;
        const winTicket = getWinnerTicketNumber();
        if (!winTicket || !state.wheelEntries.length) {
            renderWheel();
            return;
        }

        let index = state.wheelEntries.findIndex(e => Number(e.ticket_number) === winTicket);
        if (index < 0) index = 0;
        await spinToIndex(index);
    }

    async function spinToIndex(index) {
        if (!els.overlay) return;
        const wheel = byId('sl-wheel-rotor');
        if (!wheel || !state.wheelEntries.length) return;

        state.spinning = true;
        state.spinTargetIndex = index;

        const total = state.wheelEntries.length;
        const degPer = 360 / total;
        const pointerAt = 270;
        const targetCenter = (index * degPer) + (degPer / 2);
        const normalizeToPointer = (pointerAt - targetCenter + 360) % 360;
        const extraTurns = 360 * 7;
        const finalRot = extraTurns + normalizeToPointer;

        const startRot = Number(state.spinRotation || 0);
        const endRot = startRot + finalRot;

        wheel.style.transition = 'transform 7s cubic-bezier(0.12, 0.85, 0.12, 1)';
        wheel.style.transform = `rotate(${endRot}deg)`;

        state.spinRotation = endRot % 360;
        setStored(K_WHEEL_ROT, state.spinRotation);

        await sleep(7300);

        state.spinning = false;
        wheel.style.transition = '';
        wheel.style.transform = `rotate(${state.spinRotation}deg)`;
        renderWheel();

        if (state.round && state.round.status === 'drawn') {
            const winnerName = state.round.winner_name || 'Winner';
            showToast(`Winner: ${winnerName}`);
        }
    }

    function renderWheel() {
        const host = byId('sl-wheel-wrap');
        if (!host) return;

        const entries = state.wheelEntries || [];
        if (!entries.length) {
            host.innerHTML = `
                <div class="sl-empty-wheel">
                    <div class="sl-empty-wheel-inner">No tickets on the wheel yet</div>
                </div>
            `;
            return;
        }

        const total = entries.length;
        const deg = 360 / total;
        const sectors = entries.map((entry, i) => {
            const start = i * deg;
            const end = start + deg;
            const color = pickColor(i, total);
            return `${color} ${start}deg ${end}deg`;
        }).join(', ');

        const labels = entries.map((entry, i) => {
            const angle = (i * deg) + (deg / 2);
            const active = getWinnerTicketNumber() === Number(entry.ticket_number) && state.round && state.round.status === 'drawn';
            return `
                <div class="sl-wheel-label ${active ? 'winner' : ''}"
                     style="transform: rotate(${angle}deg) translateY(-38%);">
                    <span style="transform: rotate(90deg);">
                        ${esc(entry.label)}
                    </span>
                </div>
            `;
        }).join('');

        host.innerHTML = `
            <div class="sl-wheel-shell">
                <div class="sl-wheel-pointer"></div>
                <div id="sl-wheel-rotor" class="sl-wheel-rotor" style="background: conic-gradient(${sectors}); transform: rotate(${Number(state.spinRotation || 0)}deg);">
                    ${labels}
                    <div class="sl-wheel-center">${total}</div>
                </div>
            </div>
        `;
    }

    // ============================================================
    // 09. HTML BUILD
    // ============================================================

    function overviewHtml() {
        const round = state.round || {};
        const settings = state.settings || {};
        const me = state.me || {};
        const pool = Number(round.gross_pool || 0);
        const payout = Number(round.winner_payout || 0);

        return `
            <div class="sl-grid">
                <div class="sl-card">
                    <div class="sl-card-title">Current Round</div>
                    <div class="sl-stat-row"><span>Status</span><b>${esc(round.status || '-')}</b></div>
                    <div class="sl-stat-row"><span>Countdown</span><b id="sl-countdown">${esc(countdownTo(round.draw_at))}</b></div>
                    <div class="sl-stat-row"><span>Draw Time</span><b>${esc(formatDateTime(round.draw_at))}</b></div>
                    <div class="sl-stat-row"><span>Week Key</span><b>${esc(round.week_key || '-')}</b></div>
                </div>

                <div class="sl-card">
                    <div class="sl-card-title">Pool</div>
                    <div class="sl-stat-row"><span>Ticket Price</span><b>${fmtMoney(settings.ticket_price || 0)}</b></div>
                    <div class="sl-stat-row"><span>Total Tickets</span><b>${Number(round.total_tickets || 0)}</b></div>
                    <div class="sl-stat-row"><span>Gross Pool</span><b>${fmtMoney(pool)}</b></div>
                    <div class="sl-stat-row"><span>Winner Gets</span><b>${fmtMoney(payout)}</b></div>
                </div>

                <div class="sl-card">
                    <div class="sl-card-title">My Entry</div>
                    <div class="sl-stat-row"><span>Name</span><b>${esc(me.user_name || '-')}</b></div>
                    <div class="sl-stat-row"><span>My Tickets</span><b>${Number(me.ticket_count || 0)}</b></div>
                    <div class="sl-stat-row"><span>Tickets Left</span><b>${Number(me.tickets_left || 0)}</b></div>
                    <div class="sl-stat-row"><span>Faction Access</span><b>${me.is_faction_member ? 'Yes' : 'No'}</b></div>
                </div>

                <div class="sl-card">
                    <div class="sl-card-title">Last Winner</div>
                    <div class="sl-stat-row"><span>Name</span><b>${esc((state.lastWinner && state.lastWinner.winner_name) || '-')}</b></div>
                    <div class="sl-stat-row"><span>Payout</span><b>${fmtMoney((state.lastWinner && state.lastWinner.winner_payout) || 0)}</b></div>
                    <div class="sl-stat-row"><span>Ticket #</span><b>${esc((state.lastWinner && state.lastWinner.winning_ticket_number) || '-')}</b></div>
                    <div class="sl-stat-row"><span>Drawn</span><b>${esc((state.lastWinner && formatDateTime(state.lastWinner.drawn_at)) || '-')}</b></div>
                </div>
            </div>
        `;
    }

    function lotteryHtml() {
        const me = state.me || {};
        const settings = state.settings || {};
        const round = state.round || {};

        const canBuy = !!(me.is_faction_member && round.status === 'open');
        const maxAllowed = Number(settings.max_tickets_per_member || 5);
        const left = Number(me.tickets_left || 0);
        const options = [];
        for (let i = 1; i <= Math.min(maxAllowed, 5); i++) {
            options.push(`<option value="${i}" ${Number(state.buyQty) === i ? 'selected' : ''}>${i}</option>`);
        }

        return `
            <div class="sl-grid sl-grid-2">
                <div class="sl-card">
                    <div class="sl-card-title">Buy Tickets</div>
                    <div class="sl-buy-box">
                        <div class="sl-stat-row"><span>Ticket Price</span><b>${fmtMoney(settings.ticket_price || 0)}</b></div>
                        <div class="sl-stat-row"><span>My Tickets</span><b>${Number(me.ticket_count || 0)}</b></div>
                        <div class="sl-stat-row"><span>Tickets Left</span><b>${left}</b></div>
                        <div class="sl-stat-row"><span>Payment To</span><b>${esc(settings.payment_receiver_name || ADMIN_NAME)} [${Number(settings.payment_receiver_id || ADMIN_USER_ID)}]</b></div>

                        <label class="sl-label">Quantity</label>
                        <select id="sl-buy-qty" class="sl-input">
                            ${options.join('')}
                        </select>

                        <div class="sl-button-row">
                            <button id="sl-buy-btn" class="sl-btn primary" ${canBuy && left > 0 ? '' : 'disabled'}>Buy + Verify</button>
                            <button id="sl-refresh-btn" class="sl-btn">Refresh</button>
                        </div>

                        <div class="sl-note">
                            Members can buy up to ${maxAllowed} tickets per weekly draw. One verified ticket equals one slot on the wheel.
                        </div>
                    </div>
                </div>

                <div class="sl-card">
                    <div class="sl-card-title">Prize Wheel</div>
                    <div id="sl-wheel-wrap"></div>
                    <div class="sl-button-row">
                        <button id="sl-spin-btn" class="sl-btn" ${state.round && state.round.status === 'drawn' ? '' : 'disabled'}>Show Winner Spin</button>
                    </div>
                </div>
            </div>

            <div class="sl-card">
                <div class="sl-card-title">Current Entries</div>
                <div class="sl-entry-list">
                    ${(state.wheelEntries || []).length ? state.wheelEntries.map(e => `
                        <div class="sl-entry-pill ${getWinnerTicketNumber() === Number(e.ticket_number) ? 'winner' : ''}">
                            <span>${esc(e.label)}</span>
                            <b>#${Number(e.ticket_number)}</b>
                        </div>
                    `).join('') : '<div class="sl-empty">No entries yet</div>'}
                </div>
            </div>
        `;
    }

    function historyHtml() {
        const rows = state.history || [];
        return `
            <div class="sl-card">
                <div class="sl-card-title">Past Rounds</div>
                <div class="sl-history-list">
                    ${rows.length ? rows.map(r => `
                        <div class="sl-history-row">
                            <div><b>${esc(r.week_key || '-')}</b></div>
                            <div>Status: ${esc(r.status || '-')}</div>
                            <div>Winner: <b>${esc(r.winner_name || 'None')}</b></div>
                            <div>Payout: <b>${fmtMoney(r.winner_payout || 0)}</b></div>
                            <div>Tickets: <b>${Number(r.total_tickets || 0)}</b></div>
                            <div>Drawn: ${esc(formatDateTime(r.drawn_at || r.draw_at))}</div>
                        </div>
                    `).join('') : '<div class="sl-empty">No history yet</div>'}
                </div>
            </div>
        `;
    }

    function rulesHtml() {
        return `
            <div class="sl-card">
                <div class="sl-card-title">Sinner's Lottery Rules</div>
                <div class="sl-rules">
                    <div class="sl-rule"><b>Ticket price:</b> ${fmtMoney((state.settings && state.settings.ticket_price) || 1000000)} per ticket</div>
                    <div class="sl-rule"><b>Weekly cycle:</b> Sunday opening, Saturday 8:00 PM draw</div>
                    <div class="sl-rule"><b>Prize payout:</b> ${Number((state.settings && state.settings.prize_percent) || 75)}% of the gross pool</div>
                    <div class="sl-rule"><b>Ticket limit:</b> Max ${Number((state.settings && state.settings.max_tickets_per_member) || 5)} tickets per member each round</div>
                    <div class="sl-rule"><b>Access:</b> Faction members only</div>
                    <div class="sl-rule"><b>Wheel slots:</b> Your name appears once for each verified ticket</div>
                    <div class="sl-rule"><b>Payments:</b> Tickets count only after payment verification</div>
                    <div class="sl-rule"><b>Receiver:</b> ${esc((state.settings && state.settings.payment_receiver_name) || ADMIN_NAME)} [${Number((state.settings && state.settings.payment_receiver_id) || ADMIN_USER_ID)}]</div>
                    <div class="sl-rule"><b>Winner:</b> Chosen server-side, then displayed on the spinning wheel</div>
                </div>
            </div>
        `;
    }

    function adminHtml() {
        if (!isAdmin()) {
            return `<div class="sl-card"><div class="sl-card-title">Admin</div><div class="sl-empty">Admin only</div></div>`;
        }

        const settings = state.settings || {};
