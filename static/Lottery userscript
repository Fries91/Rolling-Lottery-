    function startPoll() {
        stopPoll();
        pollTimer = setInterval(async () => {
            if (els.overlay && els.overlay.style.display === 'block' && getSession()) {
                try {
                    await loadState();
                    updateCountdownText();
                    const tab = currentTab();
                    if (tab === 'lottery') {
                        await loadWheel();
                        render();
                    } else if (tab === 'history') {
                        await loadHistory();
                        render();
                    } else if (tab === 'admin' && isAdmin()) {
                        await loadAdminState();
                        render();
                    } else {
                        render();
                    }
                } catch (_) {}
            }
        }, POLL_MS);

        setInterval(updateCountdownText, 1000);
    }

    function stopPoll() {
        if (pollTimer) {
            clearInterval(pollTimer);
            pollTimer = null;
        }
    }

    function startRemountWatch() {
        if (remountTimer) clearInterval(remountTimer);
        remountTimer = setInterval(() => {
            ensureMounted();
        }, REMOUNT_MS);
    }

    function boot() {
        ensureMounted();
        render();
        startPoll();
        startRemountWatch();

        if (getStored(K_OPEN, false)) {
            toggleOverlay(true);
        }
    }

    boot();
